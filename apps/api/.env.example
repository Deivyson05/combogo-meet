# Upstash Redis (REST) — necessário para estado da sala e transcrição
UPSTASH_REDIS_REST_URL=https://xxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# URL pública desta própria API no Vercel (usada para montar o link de download)
PUBLIC_API_URL=https://combogo-meet-api.vercel.app

# Servidor Whisper auto-hospedado (faster-whisper/whisper.cpp) — ver docs/DEPLOYMENT.md
WHISPER_SERVER_URL=https://combogo-meet-whisper.fly.dev
